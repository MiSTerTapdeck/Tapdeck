{
  "expo": {
    "name": "Tapdeck",
    "slug": "tapdeck",
    "version": "1.0.1",
    "scheme": "tapdeck",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4EDDF",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Tapdeck connects to your MiSTer on your home network."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "package": "com.anonymous.tapdeck",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tapdeck-splash.png",
        "backgroundColor": "#F6EBD7"
      },
      "backgroundColor": "#F6EBD7"
    },
    "web": {
      "name": "Tapdeck — Binder preview"
    },
    "icon": "./assets/tapdeck-splash.png",
    "extra": {
      "eas": {
        "projectId": "9db8a196-fd04-41b9-81d9-4a2498823b9b"
      }
    },
    "owner": "azzazzos-team"
  }
}
